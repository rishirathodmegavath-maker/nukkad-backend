# Copy this file to .env and fill in real values. Never commit .env.

# --- MySQL (docker-compose) ---
DB_HOST=localhost
DB_PORT=3307
DB_NAME=nukkad
DB_USERNAME=nukkad_app
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root

# --- JWT ---
# Generate one with: openssl rand -base64 64
JWT_SECRET=replace-with-a-256-bit-base64-secret
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5174

# --- Server ---
SERVER_PORT=8082

# --- Google Sign-In ---
# From Google Cloud Console > APIs & Services > Credentials. Only the client ID
# is needed here (used server-side to verify ID token audience); the client
# secret is not required for the Sign In With Google (ID token) flow.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id.apps.googleusercontent.com

# --- Chat message encryption at rest (AES-256-GCM) ---
# Generate one with: openssl rand -base64 32
MESSAGE_ENCRYPTION_KEY=replace-with-a-base64-256-bit-key
