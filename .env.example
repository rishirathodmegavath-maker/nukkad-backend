# Copy this file to .env and fill in real values. Never commit .env.

# --- MySQL (docker-compose) ---
DB_HOST=localhost
DB_PORT=3307
DB_NAME=nukkad
DB_USERNAME=nukkad_app
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root

# --- JWT ---
# Generate one with: openssl rand -base64 64
JWT_SECRET=replace-with-a-256-bit-base64-secret
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5174

# --- Server ---
SERVER_PORT=8082
# https://app.buildadda.com in production, http://localhost:5173 locally -- used to build links in
# outgoing member emails (verification, password reset).
FRONTEND_BASE_URL=http://localhost:5173
# The admin portal's own origin (https://admin.buildadda.com in production) -- used for the admin
# password-reset email link. Must be set before enabling SMTP, or that link points at localhost.
ADMIN_BASE_URL=http://localhost:5174
# false skips email verification entirely -- the escape hatch while no SMTP is configured; leave
# true once SMTP_* below is set.
REQUIRE_EMAIL_VERIFICATION=true
# Set to false in production to stop serving the full API schema/Swagger UI publicly
# (https://api.buildadda.com/v3/api-docs, /swagger-ui.html) -- fine to leave true for local dev.
SPRINGDOC_ENABLED=true

# --- SMTP (optional) ---
# Defaults below target local Mailpit (docker-compose.yml). For a real provider, set SMTP_HOST to
# it, SMTP_PORT/AUTH/STARTTLS as it requires (587/true/true is typical), and set
# REQUIRE_EMAIL_VERIFICATION=true once mail is actually flowing.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@buildadda.com

# --- Google Sign-In ---
# From Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id.apps.googleusercontent.com
# Only needed for the redirect-based OAuth code flow (POST /auth/google/code), which exchanges
# an authorization code for Google's ID token server-side. Not used by the direct ID-token flow.
# Same OAuth client as above — Google generates this secret automatically; find it under the
# client's own settings. Never expose this to the frontend.
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret

# --- Chat message encryption at rest (AES-256-GCM) ---
# Generate one with: openssl rand -base64 32
MESSAGE_ENCRYPTION_KEY=replace-with-a-base64-256-bit-key

# --- Admin bootstrap (optional, one-time) ---
# Only needed to establish the very first platform Admin. Leave all three blank in normal
# operation — there is no default admin account and nothing is ever auto-promoted.
#
# If EMAIL + PASSWORD are set and no account exists for that email yet, the app creates one
# (ACTIVE, ADMIN role) on next startup. Safe to leave set indefinitely: once the account exists,
# every later restart is a no-op (nothing is re-created, no password reset, no role change).
#
# If EMAIL + PASSWORD are set and an account with that email ALREADY exists (e.g. someone already
# registered with it), it is left untouched by default — a startup warning is logged instead of
# silently granting admin access. Only set ALLOW_PROMOTION=true if you specifically intend to
# promote that exact existing account; then remove it again (or leave it — subsequent restarts
# are still no-ops once the account has ADMIN).
#
# Example values below are placeholders — never commit real credentials here.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
ADMIN_BOOTSTRAP_ALLOW_PROMOTION=false

# --- File storage (S3-compatible object storage) ---
# Works with real AWS S3, Cloudflare R2, DigitalOcean Spaces, Backblaze B2, or a
# self-hosted MinIO — the code is provider-agnostic. Defaults below target the local
# MinIO service in docker-compose.yml for dev; for real AWS S3 in production, leave
# S3_ENDPOINT_OVERRIDE empty and set S3_FORCE_PATH_STYLE=false.
S3_BUCKET=nukkad-uploads
S3_REGION=us-east-1
S3_ENDPOINT_OVERRIDE=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# The URL prefix used to build the public link returned for every uploaded file
# (a CDN domain in production, or the bucket's own public endpoint).
S3_PUBLIC_BASE_URL=http://localhost:9000/nukkad-uploads
# Standard AWS SDK credential env vars — recognized automatically, no custom config needed.
AWS_ACCESS_KEY_ID=nukkad-dev
AWS_SECRET_ACCESS_KEY=nukkad-dev-secret
# Only read by docker-compose.prod.yml's minio/minio-init services (not by the backend app
# itself) — set these to the SAME values as AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY above.
MINIO_ROOT_USER=nukkad-dev
MINIO_ROOT_PASSWORD=nukkad-dev-secret
